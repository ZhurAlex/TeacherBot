# Dummy values for test runs — never real secrets, safe to commit.
# Loaded by tests/conftest.py before config.settings (and its real .env-backed
# credentials) can be imported, so tests can never accidentally hit real
# Gemini/Mistral/Telegram APIs, burn real tokens, or write to the real database.
# Must define every variable config/settings.py reads — any missing one would
# silently fall back to the real value from .env.
GEMINI_API_KEY=test-gemini-key
MISTRAL_API_KEY=test-mistral-key
BOT_TOKEN = test-bot-token
POSTGRES_USER = test-postgres-user
POSTGRES_PASSWORD = test-postgres-password
POSTGRES_DB = test-postgres-db
